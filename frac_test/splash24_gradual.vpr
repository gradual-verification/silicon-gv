field balance: Int

method doubleBal(a: Ref) returns (res: Int)
    requires ? && true
    ensures acc(a.balance, 1/2) && res == 2 * a.balance // runtime check for acc(a.balance, 1/2)
{
    var t1 : Int
    var t2 : Int

    t1 := a.balance // runtime check for acc(a.balance, epsilon)
    t2 := a.balance
    res := t1 + t2
}

// no runtime checks
method setBal(a: Ref, amount: Int)
    requires acc(a.balance, 1/1)
    ensures acc(a.balance, 1/1) && a.balance == amount
{
    a.balance := amount
}

method addBal(a: Ref, b: Ref) returns (res: Int)
    requires ? && acc(b.balance, 1/2)
    ensures acc(b.balance, 1/2) && 
    res == b.balance
{
    var balA: Int
    balA := a.balance // runtime check for acc(a.balance, epsilon)
    
    var balB: Int
    balB := b.balance

    b.balance := balA + balB // runtime check for acc(b.balance, write)
    res := b.balance        
}
