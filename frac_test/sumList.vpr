field val: Int
field next: Ref

method sumList(l: Ref) returns (sum: Int) 
    requires ? && true
    ensures ? && true
{ 
    if (l == null) {
        sum := 0
    } else {
        sum := sumList(l.next)
        sum := sum + l.val
    }
}

method main()
    requires true
{
    var tail: Ref
    tail := new(val, next)
    tail.val := 5
    tail.next := null

    var l4: Ref
    l4 := new(val, next)
    l4.val := 4
    l4.next := tail

    var l3: Ref
    l3 := new(val, next)
    l3.val := 3
    l3.next := l4

    var l2: Ref
    l2 := new(val, next)
    l2.val := 2
    l2.next := l3

    var l1: Ref
    l1 := new(val, next)
    l1.val := 1
    l1.next := l2

    var head: Ref
    head := new(val, next)
    head.val := 0
    head.next := l1

    var j : Int
    j := sumList(head)
}