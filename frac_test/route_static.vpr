field x: Int
field current: Ref


method count_inside(r: Ref, a: Ref, b: Ref) returns (res: Int)
    requires acc(r.current, 1/100) && acc(r.current.x, 1/100) && acc(a.x, 1/100) && acc(b.x, 1/100)
    ensures acc(r.current, 1/100) && acc(r.current.x, 1/100) && acc(a.x, 1/100) && acc(b.x, 1/100)
{
    res := a.x - b.x
}

method make_first_unique(r: Ref) 
    requires acc(r.current, write) && acc(r.current.x, write)
    ensures acc(r.current, write) && acc(r.current.x, write) 
{ 
    var first: Ref
    first := r.current

    var first2: Ref
    first2 := first

    var c: Int
    c := count_inside(r, first, first2)
    
    if (c > 1) {
        assert first.x == r.current.x
        r.current.x := r.current.x + 1
    }
}

method main()
{
    var point: Ref
    point := new(x)
    point.x := 27

    var r: Ref
    r := new(current)
    r.current := point

    make_first_unique(r)

    r.current.x := 10
}

