// Contains simple examples of fully static programs that use fractional permissions

field f: Int

method exhal(a: Ref, p: Perm)  // helper method for mimicking exhale
  requires p >= 0/1 && acc(a.f, p)  {}

method client(a: Ref)
  requires acc(a.f) && a.f < 5
{
  set(a, 5)
  a.f := 6
}

method set(x: Ref, i: Int)
  requires acc(x.f) && x.f < i
  ensures  acc(x.f) && x.f == i
{
  x.f := i
}

method copyAndInc(x: Ref, y: Ref)
  requires acc(x.f) && acc(y.f, 1/2)
  ensures  acc(x.f) && acc(y.f, 1/2)
  ensures x.f == y.f + 1
{
  x.f := y.f + 1
}

method client2(a: Ref, b: Ref) 
  requires acc(a.f) && acc(b.f)
{
  a.f := 1
  b.f := 3

  copyAndInc(a, b)

  assert b.f == 3 && a.f == 4
}

// should fail - permission > 1
method tooMuchPerm(x: Ref)
  requires acc(x.f, 8/10) && acc(x.f, 3/10)
  ensures true
{
  exhal(x, 0/1)
}

// currently evalpc does not handle conditional expressions
/*
// should fail - don't know if p >= 0 when trying to consume acc(x.f, p) in postcondition.
method negativePerm(p: Perm, x: Ref)
  requires acc(x.f, p > 0/1 ? p : 1/1) 
  requires acc(x.f, p)
{
}
*/

// should fail - insufficient permission
method copyAndInc2(x: Ref, y: Ref)
  requires acc(x.f, 9/10) && acc(y.f, 1/2)
  ensures  acc(x.f) && acc(y.f, 1/2)
{
  x.f := y.f + 1
}

// should fail - insufficient permission
method copyAndInc3(x: Ref, y: Ref)
  requires acc(x.f) && acc(y.f, none)
  ensures  acc(x.f) && acc(y.f, 1/2)
{
  x.f := y.f + 1
}

method separation(x: Ref, y: Ref) 
  requires acc(x.f, 3/4) && acc(y.f, 1/2)
  ensures acc(y.f, 1/2)
{
  assert x != y
  exhal(x, 1/4)
  assert x != y
}

method preservation(x: Ref)
  requires acc(x.f, write)
{
  var y: Ref
  y := new(f)
  y.f := 20

  separation(x, y)

  assert y.f == 20
}

