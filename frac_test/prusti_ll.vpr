// try to translate some of this https://viperproject.github.io/prusti-dev/user-guide/tour/final.html into viper (only verify memory safety)

// Link struct 
field elem: Int
field next: Ref

// List struct (head points to a "Link" struct )
field head: Ref 

predicate acyclicSeg(from: Ref, to: Ref) {
    (from == to) ? true : acc(from.elem) && acc(from.next) && acyclicSeg(from.next, to)
}

predicate acyclic(list: Ref) {
    acc(list.head) && acyclicSeg(list.head, null)
}

method len(list: Ref) returns (length: Int) 
    requires acc(acyclic(list), 1/100)
    ensures acc(acyclic(list), 1/100)
{
    unfold acc(acyclic(list), 1/100)
    length := link_len(list.head)
    fold acc(acyclic(list), 1/100)
}

method link_len(link: Ref) returns (length: Int) 
    requires acc(acyclicSeg(link, null), 1/100)
    ensures acc(acyclicSeg(link, null), 1/100)
{
    unfold acc(acyclicSeg(link, null), 1/100)

    if (link == null) {
        length := 0
    } else {
        var r: Int
        r := link_len(link.next)
        length := 1 + r
    }
    
    fold acc(acyclicSeg(link, null), 1/100)
}

method is_empty(list: Ref) returns (b: Bool) 
    requires acyclic(list)
    ensures acyclic(list)
{   
    unfold acyclic(list)
    b := list.head == null 
    fold acyclic(list)
}

method new_l() returns (list: Ref) 
    ensures acyclic(list)
{
    list := new(head)
    list.head := null
    fold acyclicSeg(list.head, null)
    fold acyclic(list)
}

method lookup(list: Ref, index: Int) returns (link: Ref) 
    requires acc(acyclic(list), 1/100)
    ensures acc(acyclic(list), 1/100)
{
    unfold acc(acyclic(list), 1/100)
    link := link_lookup(list.head, index)
    fold acc(acyclic(list), 1/100)
}

method link_lookup(link: Ref, index: Int) returns (found_link: Ref)
    requires acc(acyclicSeg(link, null), 1/100)
    ensures acc(acyclicSeg(link, null), 1/100) // && acc(found_link.elem, 1/100) // i have skill issue and can't verify this right now
{   
    unfold acc(acyclicSeg(link, null), 1/100)

    if (link == null) { // in prusti this case never happens since index is verified to be <= length of list
        found_link := null
    }
    else {
        if (index == 0) {
            found_link := link
        } else {
            var l: Ref
            l := link_lookup(link.next, index - 1)
            found_link := l
        }
    }

    fold acc(acyclicSeg(link, null), 1/100)
} 

method push(list: Ref, val: Int) 
    requires acc(acyclic(list), write)
    ensures acc(acyclic(list), write)
{
    unfold acyclic(list)

    var new_node: Ref
    new_node := new(elem, next)
    new_node.elem := val
    new_node.next := list.head
    list.head := new_node

    fold acyclicSeg(list.head, null)
    fold acyclic(list)
}

method pop(list: Ref) returns (head_val: Int)
    requires acc(acyclic(list), write)
    ensures acc(acyclic(list), write)
{
    unfold acyclic(list)

    if (list.head == null) {
        head_val := -1
        fold acyclic(list)
    } else {
        unfold acyclicSeg(list.head, null)
        head_val := list.head.elem
        list.head := list.head.next
        fold acyclic(list)
    }
}

