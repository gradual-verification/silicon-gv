method peek(list: Ref) returns (h: Ref) 
    requires acyclic(list)
    ensures acyclic(list)
{
    h := lookup(list, 0)
}

// peek_mut not included since mutable reborrowing is probably just not possible to model

method test_list() {
    var list: Ref
    list := new_l()
    
    var emp: Bool
    emp := is_empty(list)

    push(list, 5)
    push(list, 10)

    var length: Int
    length := len(list)

    var lookup1: Ref
    var lookup2: Ref

    lookup1 := lookup(list, 0)
    lookup2 := lookup(list, 1)


    var x: Int
    x := pop(list)

    var peek1: Ref
    peek1 := peek(list)
}

