//:: IgnoreFile(/silicon/issue/233/)
// Issue: Seq keyword

field seq: Seq[Int]

method foo(x: Ref) returns (value: Int)
  requires acc(x.seq) && |x.seq| > 1
  //:: ExpectedCounterexample(postcondition.violated:assertion.false, (x.seq[1] == 42))
  ensures  value != 42
{
  value := x.seq[1]
}
